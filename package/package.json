{
  "name": "prototype-machine",
  "version": "0.13.0",
  "description": "A dev-only control panel for React prototypes. Declare the states as state machines, so combinations you never declared can't be set.",
  "author": "Daniel Neath (https://github.com/dneath)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dneath/prototype-machine.git",
    "directory": "package"
  },
  "homepage": "https://github.com/dneath/prototype-machine#readme",
  "bugs": {
    "url": "https://github.com/dneath/prototype-machine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "production": {
        "import": {
          "types": "./dist/production.d.ts",
          "default": "./dist/production.js"
        },
        "require": {
          "types": "./dist/production.d.cts",
          "default": "./dist/production.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./panel": {
      "import": {
        "types": "./dist/panel.d.ts",
        "default": "./dist/panel.js"
      },
      "require": {
        "types": "./dist/panel.d.cts",
        "default": "./dist/panel.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SKILL.md",
    "reference"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.cjs",
    "lint:package": "node scripts/lint-package.mjs",
    "test:pack": "node scripts/pack-test.mjs",
    "tarball": "node scripts/tarball.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run smoke && npm run lint:package && npm run test:pack",
    "version": "node scripts/sync-version.mjs",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/prepack.mjs --clean",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "prototype",
    "state-machine",
    "scenario",
    "design",
    "devtools",
    "react",
    "control-panel",
    "empty-state",
    "loading-state",
    "component-states",
    "state-bench",
    "prototyping",
    "design-tools",
    "agent-skill"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "publint": "0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  },
  "publishConfig": {
    "access": "public"
  }
}
